{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    },
    {
        "source": "/(.*)",
        "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server": {
      "runtime": "@vercel/python",
      "memory": 1024,
      "maxDuration": 10
    }
  }
}